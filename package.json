{
  "name": "akadverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma generate --schema=prisma/elearning/schema.prisma && next build",
    "postinstall": "prisma generate && prisma generate --schema=prisma/elearning/schema.prisma",
    "start": "next start",
    "lint": "eslint",
    "db:elearning:generate": "prisma generate --schema=prisma/elearning/schema.prisma",
    "db:elearning:push": "prisma db push --schema=prisma/elearning/schema.prisma",
    "db:elearning:migrate": "prisma migrate dev --schema=prisma/elearning/schema.prisma",
    "db:elearning:studio": "prisma studio --schema=prisma/elearning/schema.prisma",
    "db:elearning:seed": "tsx scripts/elearning-seed.ts",
    "storage:setup": "tsx scripts/setup-course-material-storage.ts",
    "ccmas:extract": "python3 scripts/ccmas/extract_ccmas.py",
    "db:ccmas:import": "tsx scripts/ccmas/import-ccmas.ts",
    "sync:vercel-env": "./scripts/sync-vercel-env.sh production"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
