generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime uses the pooled connection (Supabase's pgbouncer, port
  // 6543) — fine for ordinary queries. `prisma migrate`/`db push` need
  // directUrl instead: DDL and Prisma's own migration advisory locks hang
  // indefinitely against the transaction-mode pooler, so those commands
  // use the direct/session connection (port 5432) via DIRECT_URL. See
  // .env.example.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Which portal a user lands on after signing in, and what they're allowed
// to see. Every new account defaults to `student` (see User.role below) —
// promoting someone to faculty/admin/super_admin is a manual step for now,
// there's no self-service upgrade path yet.
enum Role {
  student
  faculty
  admin
  super_admin
}

model User {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String
  email           String           @unique
  password        String
  role            Role             @default(student)
  // Marketplace admin access, orthogonal to `role` — a student, faculty,
  // admin, or super_admin account can independently also be an admin (a
  // student who is also an admin, a faculty member who is also an admin,
  // etc). Replaces the earlier super_admin-role-only gate — see
  // docs/admin/decisions/admin-flag-replaces-role-check.md. Checked by
  // src/lib/admin.ts#requireAdmin, carried on the session by
  // src/lib/auth.ts's jwt/session callbacks.
  isAdmin         Boolean          @default(false)
  location        String?
  // Deliverer application's student-email verification (see
  // docs/marketplace/systems/vendor-delivery-system.md and
  // services/marketplace/deliverer/request-student-email-otp.ts). The
  // applicant only ever supplies the local part — the canonical
  // "<local>@stu.cu.edu.ng" address is constructed server-side, never
  // trusted from the client. studentEmailVerifiedAt proves OTP possession
  // of that mailbox only; it is NOT proof of university enrollment and is
  // deliberately kept separate from Deliverer.status (admin approval),
  // since verifying the email and being approved as a deliverer are two
  // different gates. The OTP itself (code/expiry/attempts/last-sent) lives
  // on separate fields added alongside the deliverer-application feature.
  studentEmailLocalPart  String?
  studentEmailVerifiedAt DateTime?
  studentEmailOtp            String?
  studentEmailOtpExpiry      DateTime?
  studentEmailOtpAttempts    Int       @default(0)
  studentEmailOtpLastSentAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  businesses      Business[]
  cartItems       CartItem[]
  emailConnection EmailConnection?
  orders          Order[]
  schedules       Schedule[]
  skills          Skill[]
  skillOffers     SkillOffer[]     @relation("BuyerOffers")
  skillReviews    SkillReview[]    @relation("BuyerReviews")
  suggestions     Suggestion[]
  tasks           Task[]
  // A user's deliverer application/status, if they've ever applied — no row
  // means "not applied" (see the footer's "Become a Deliverer" state logic
  // in src/lib/deliverer.ts). Deliberately a relation, not a status column
  // duplicated onto User, so the application's own data (name/email at
  // application time, approval audit fields) lives in one place.
  deliverer       Deliverer?
  businessReports BusinessReport[]
  notifications   Notification[]
  vendorDeliveryBookings VendorDeliveryBooking[]

  @@index([email])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Order / Delivery / Escrow domain
//
// See docs/marketplace/systems/ and docs/marketplace/data/ for the full
// write-up of how these fit together. Short version:
//   Order            — one seller's (one business's) side of a checkout;
//                       carries the seller's accept/reject decision and
//                       fulfillment progress up to hand-off.
//   OrderItem        — one line of that order; carries delivery-attempt and
//                       escrow/payout state, since different items in the
//                       same order can end up delivered, failed, or
//                       refunded independently of each other.
//   Deliverer        — an approved delivery person.
//   Delivery         — one deliverer's assigned run (a set of DeliveryItems
//                       picked up from one or more businesses on one day).
//   DeliveryItem     — one OrderItem, as tracked through that run.
//   Delivery_x_businesses — the pickup handoff record between one deliverer
//                       and one business for one drop-off (this is where the
//                       seller→deliverer OTP lives).
//   OrderEvent       — append-only history of who did what, when.
// ---------------------------------------------------------------------------

// The seller's decision on their side of a checkout. PENDING_SELLER is the
// literal initial value (not a display label) — every new Order starts here
// and the seller has 24 hours to move it to ACCEPTED or REJECTED before the
// seller-response cron (src/app/api/cron/seller-response/route.ts)
// auto-rejects it. CANCELLED is distinct from REJECTED: REJECTED is a
// seller (or timeout) decision before/at acceptance; CANCELLED is what an
// ACCEPTED order becomes if delivery fails twice (see DeliveryAttempted).
enum OrderStatus {
  PENDING_SELLER
  ACCEPTED
  REJECTED
  CANCELLED
}

// Where an ACCEPTED order is in the seller's own prep, up to the moment it
// leaves the seller's hands. Only meaningful once Order.status = ACCEPTED.
enum FulfillmentStatus {
  PROCESSING
  READY_FOR_PICKUP
  HANDED_TO_DELIVERER
}

// Per-item delivery progress, from deliverer assignment through final
// outcome. Lives on OrderItem (not Order) because items in the same order
// can diverge — see Order.deliveryOutcome for the order-level rollup.
enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPTED
  DELIVERED
  FAILED
  RETURNED
}

// Order-level rollup of its items' DeliveryStatus, recomputed whenever an
// item's delivery status changes (src/lib/order-events.ts#recomputeOrderDeliveryOutcome).
// Kept separate from OrderStatus/FulfillmentStatus deliberately — an order
// can be ACCEPTED and HANDED_TO_DELIVERER while its *delivery* outcome is
// still PENDING, then later PARTIALLY_DELIVERED once some items land and
// others don't.
enum OrderDeliveryOutcome {
  PENDING
  // Deliverer has marked the order delivered, but the buyer's 24-hour
  // dispute window (see docs/marketplace/systems/vendor-delivery-system.md)
  // hasn't elapsed yet. Only used by the School Vendor delivery flow today
  // — Business orders go straight PENDING -> DELIVERED, since Business has
  // no equivalent dispute-hold requirement. Deliverer payout
  // (Delivery_x_businesses.delivererPayoutStatus) stays gated while an
  // order sits in this state.
  DELIVERED_PENDING_DISPUTE_WINDOW
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  CANCELLED
}

// Tri-state, not a boolean — PENDING (no attempt made yet) is a distinct,
// meaningful state from FALSE (an attempt was made and failed). Collapsing
// this into a boolean would make "not yet attempted" indistinguishable from
// "attempted and failed."
enum DeliveryAttempted {
  PENDING
  TRUE
  FALSE
}

// An item's money, once payment is collected. HELD is the resting state
// after checkout; everything else is where it goes from there — either back
// to the buyer (REFUND_PENDING/REFUNDED, if the seller rejects/cancels the
// item) or out to the seller (PAYOUT_PENDING/PAYOUT_PROCESSING/PAID_OUT, if
// it's delivered). This is deliberately separate from PayoutStatus below —
// this tracks the item's money as a whole; PayoutStatus tracks the specific
// bank-transfer attempt to the seller, which can fail and retry
// independently of the item's overall escrow state.
enum EscrowPaymentStatus {
  HELD
  REFUND_PENDING
  REFUNDED
  PAYOUT_PENDING
  PAYOUT_PROCESSING
  PAID_OUT
}

// The seller-payout cron (src/app/api/cron/seller-payout/route.ts) only
// ever moves an item PENDING -> PROCESSING -> SUCCESS, or PROCESSING ->
// FAILED (eligible for a later retry, which starts a fresh PENDING cycle —
// see payoutAttempts on OrderItem). SUCCESS is set only after Paystack
// actually confirms the transfer, never optimistically.
enum PayoutStatus {
  PAYOUT_PENDING
  PAYOUT_PROCESSING
  PAYOUT_SUCCESS
  PAYOUT_FAILED
}

enum DelivererStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum FineStatus {
  PENDING
  PAID
}

// Every meaningful thing that happens to an order, in order, so "who did
// this and when" is always answerable (src/lib/order-events.ts#recordOrderEvent).
// A superset of what actually gets recorded by the current implementation —
// see docs/marketplace/systems/order-history-system.md for which of these
// are wired up today vs. reserved for a later phase.
enum OrderEventType {
  ORDER_CREATED
  SELLER_NOTIFIED
  SELLER_ACCEPTED
  SELLER_REJECTED
  SELLER_AUTO_REJECTED
  SELLER_PROCESSING
  SELLER_MARKED_READY
  // Seller has requested the Seller -> Coordinator handoff and been issued
  // an OTP to show the coordinator in person. Distinct from SELLER_DROPPED_OFF,
  // which only fires once the coordinator actually verifies that OTP.
  SELLER_DROPOFF_OTP_ISSUED
  SELLER_DROPPED_OFF
  // The delivery coordinator's side of the same handoff — always recorded
  // in the same transaction as SELLER_DROPPED_OFF, but kept as its own
  // event so the audit trail names the coordinator as a distinct actor.
  COORDINATOR_RECEIVED
  SELLER_MISSED_DROPOFF_DEADLINE
  DELIVERER_ASSIGNED
  DELIVERER_PICKUP_OTP_ISSUED
  DELIVERER_PICKUP_OTP_VERIFIED
  DELIVERER_CONFIRMED_PICKUP
  HANDED_TO_DELIVERER
  OUT_FOR_DELIVERY
  BUYER_DELIVERY_OTP_ISSUED
  BUYER_OTP_VERIFICATION_ATTEMPTED
  BUYER_OTP_VERIFIED
  DELIVERY_ATTEMPTED
  DELIVERY_FAILED
  DELIVERY_RETRY_SCHEDULED
  RETURNED_TO_DROPOFF
  DELIVERED
  PARTIALLY_DELIVERED
  ITEM_CANCELLED
  REFUND_INITIATED
  REFUND_COMPLETED
  PAYOUT_PENDING
  PAYOUT_PROCESSING
  PAYOUT_SUCCESS
  PAYOUT_FAILED
  LATE_DELIVERY_FINE_ISSUED
  LATE_DELIVERY_FINE_PAID
  BUSINESS_DELIVERY_RESTRICTED
  BUSINESS_DELIVERY_UNRESTRICTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  // School Vendor additions — see docs/marketplace/systems/vendor-system.md
  // and vendor-delivery-system.md. Kept in this same enum (rather than a
  // parallel one) so OrderEvent stays the single append-only history for
  // every order, vendor or Business.
  VENDOR_APPLICATION_SUBMITTED
  VENDOR_APPLICATION_APPROVED
  VENDOR_APPLICATION_REJECTED
  VENDOR_PAUSED
  VENDOR_UNPAUSED
  VENDOR_SLOT_BOOKED
  DELIVERER_STUDENT_OTP_VERIFIED
  DISPUTE_WINDOW_STARTED
  DISPUTE_WINDOW_ELAPSED
  DELIVERER_PAYOUT_PENDING
  DELIVERER_PAYOUT_PROCESSING
  DELIVERER_PAYOUT_SUCCESS
  DELIVERER_PAYOUT_FAILED
  DELIVERER_PAYOUT_REJECTED
  VENDOR_ITEM_REFUND_INITIATED
  VENDOR_ITEM_REFUND_COMPLETED
}

// One row per user who has ever submitted a deliverer application. Created
// at application time with status=PENDING; an admin then approves/rejects
// it (see /api/marketplace/admin/deliverers). Suspension is a separate,
// later transition an admin can apply to an already-approved deliverer.
model Deliverer {
  id               String                  @id @default(uuid())
  userId           String                  @unique
  firstName        String
  lastName         String
  email            String
  phone            String?
  // School Vendor delivery additions — hall/room are location info (spec
  // §34), only ever shown to whoever legitimately needs it for a specific
  // assigned delivery (see docs/marketplace/security/authentication-and-authorization.md
  // for the general privacy rule this follows). preferredAvailability is a
  // comma-separated list of VendorDeliverySlot ids/labels the applicant
  // prefers — a preference only, never a guarantee; actual assignment is
  // controlled by the Vendor Delivery admin (spec §37).
  hall             String?
  room             String?
  preferredAvailability String?
  // Deliverer payout bank details — mirrors Business's equivalent fields
  // exactly (see Business.bankName/bankCode/accountNumber/accountHolderName/
  // paystackRecipientCode's own comments). Used by
  // services/marketplace/vendor-delivery/payout/process-deliverer-payout.ts.
  bankName              String?
  bankCode              String?
  accountNumber         String?
  accountHolderName     String?
  paystackRecipientCode String?
  status           DelivererStatus         @default(PENDING)
  appliedAt        DateTime                @default(now())
  approvedAt       DateTime?
  approvedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?                 @db.Text
  suspendedAt      DateTime?
  suspensionReason String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries       Delivery[]
  businessHandoffs Delivery_x_businesses[]
  rosterAssignments DelivererRosterAssignment[]

  @@index([status])
}

// One deliverer's assigned run — created by the delivery coordinator
// (POST /api/marketplace/admin/deliveries, see
// docs/marketplace/systems/delivery-coordinator-system.md) once businesses
// have dropped items at the central drop-off point. A single Delivery can
// span multiple businesses' items (see DeliveryItem.businessId) but always
// belongs to exactly one deliverer.
model Delivery {
  id                 String         @id @default(uuid())
  deliverymanId      String
  expectedDeliveryAt DateTime?
  status             DeliveryStatus @default(ASSIGNED)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deliveryman        Deliverer      @relation(fields: [deliverymanId], references: [id])
  items              DeliveryItem[]

  @@index([deliverymanId])
  @@index([status])
}

// One OrderItem, as tracked through a specific Delivery run. Deliberately
// 1:1 with OrderItem (@unique orderItemId) — a deliverer only ever handles
// order items businesses have already marked READY_FOR_PICKUP; this table
// is never used to let a deliverer invent a new item (see
// docs/marketplace/systems/deliverer-system.md).
model DeliveryItem {
  id          String         @id @default(uuid())
  deliveryId  String
  orderItemId String         @unique
  quantity    Int
  status      DeliveryStatus @default(ASSIGNED)
  businessId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  delivery    Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  business    Business       @relation(fields: [businessId], references: [id])

  @@index([deliveryId])
  @@index([businessId])
  @@index([status])
}

// The delivery Coordinator <-> Deliverer handoff record for one
// (deliverer, business) pair at the central drop-off point — the *second*
// of the three chain-of-custody handoffs (Seller -> Coordinator -> Deliverer
// -> Buyer; see docs/marketplace/systems/delivery-coordinator-system.md).
// This is where the coordinator->deliverer OTP (pickupOtp) lives — one OTP
// covers the whole handoff of that business's ready items to that
// deliverer, not one OTP per item, since they're physically handed over
// together. The coordinator is always an admin (requireAdmin()) acting via
// assign-delivery.ts; the deliverer verifies via confirm-pickup.ts. See
// docs/marketplace/security/otp-security.md.
model Delivery_x_businesses {
  id                         String         @id @default(uuid())
  deliverymanId              String
  businessId                 String
  deliveryStatus             DeliveryStatus @default(ASSIGNED)
  expectedDeliveryAt         DateTime?
  pickupOtp                  String?
  pickupOtpExpiry            DateTime?
  pickupOtpAttempts          Int            @default(0)
  delivererConfirmedPickupAt DateTime?
  // Set once the pickup-deadline-reminder cron has emailed the deliverer
  // about this handoff's approaching pickupOtpExpiry, so it fires once per
  // handoff rather than every cron run. See
  // services/marketplace/delivery/send-pickup-deadline-reminders.ts.
  pickupDeadlineReminderSentAt DateTime?
  // Deliverer payment for this handoff — School Vendor only, mirroring
  // OrderItem's existing seller-payout field shape exactly rather than
  // inventing a parallel payment system (see
  // docs/marketplace/decisions/vendor-extends-business.md). Deliberately
  // gated: delivererPayoutStatus stays null until the linked order(s)'
  // 24-hour dispute window has elapsed with no unresolved dispute (see
  // OrderDeliveryOutcome.DELIVERED_PENDING_DISPUTE_WINDOW) — the vendor
  // cron that flips that window is also what sets this to PAYOUT_PENDING.
  delivererPayoutAmount        Float?
  delivererPayoutStatus        DelivererPayoutStatus?
  delivererPayoutAttempts      Int            @default(0)
  delivererPayoutProcessingAt  DateTime?
  delivererPayoutSucceededAt   DateTime?
  delivererPayoutFailedAt      DateTime?
  delivererPayoutFailureReason String?        @db.Text
  delivererPayoutReference     String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  deliveryman                Deliverer      @relation(fields: [deliverymanId], references: [id])
  business                   Business       @relation(fields: [businessId], references: [id])

  @@index([deliverymanId])
  @@index([businessId])
  @@index([delivererPayoutStatus])
}

// Mirrors PayoutStatus (OrderItem's seller-payout enum) with one addition:
// REJECTED, set when a dispute is resolved against the deliverer (see
// docs/marketplace/systems/vendor-delivery-system.md) — this is a
// terminal "deliberately not paid" state, distinct from PAYOUT_FAILED
// (a retryable provider-side failure).
enum DelivererPayoutStatus {
  PAYOUT_PENDING
  PAYOUT_PROCESSING
  PAYOUT_SUCCESS
  PAYOUT_FAILED
  REJECTED
}

// Append-only history for one order (optionally scoped to one item). The
// single source of truth for "who did what, when" — see
// docs/marketplace/systems/order-history-system.md. Never updated or
// deleted once written.
model OrderEvent {
  id          String         @id @default(uuid())
  orderId     String
  orderItemId String?
  type        OrderEventType
  actorType   String
  actorId     String?
  message     String?        @db.Text
  metadata    Json?
  createdAt   DateTime       @default(now())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
  @@index([type])
  @@index([createdAt])
}

// One selected day of the week a business accepts deliveries on. A join
// table (not a String[]) both because MySQL/Prisma doesn't support scalar
// list columns and because "up to 4 selected days" is a real one-to-many
// relationship, not a denormalized blob (see
// docs/marketplace/data/delivery-days.md).
model BusinessDeliveryDay {
  id         String    @id @default(uuid())
  businessId String
  day        DayOfWeek
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
  @@index([businessId])
}

// One late-delivery fine issued to a business for missing the seller
// drop-off deadline (see docs/marketplace/decisions/seller-dropoff-deadline.md).
// A business can incur more than one over its lifetime, so this is its own
// table rather than single overwritable fields on Business — Business only
// carries the *current* restriction flag (see Business.deliveryRestricted).
model LateDeliveryFine {
  id                String     @id @default(uuid())
  businessId        String
  orderId           String?
  amount            Float
  status            FineStatus @default(PENDING)
  paystackReference String?
  paidAt            DateTime?
  createdAt         DateTime   @default(now())
  business          Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}

model EmailConnection {
  id           String    @id @default(uuid())
  userId       String    @unique
  email        String
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  tokenExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Suggestion {
  id              String   @id @default(uuid())
  userId          String
  category        String
  message         String   @db.Text
  hasAttachments  Boolean  @default(false)
  attachmentCount Int      @default(0)
  attachmentNames Json?
  source          String   @default("studashboard/essentials/suggestions")
  status          String   @default("new")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

// A business's lifecycle before it's allowed to operate normally.
// PENDING_APPROVAL is the default for every newly created business — it's
// not visible in marketplace listings/search and can't receive orders
// until an admin approves it (see services/marketplace/business/create-business.ts
// and services/marketplace/admin/approve-business.ts). Existing businesses
// created before this system existed were grandfathered to APPROVED by
// this field's own migration, so no current seller lost access.
// SUSPENDED is reserved for an admin pulling an already-approved business
// back out of the marketplace without going through REJECTED (which
// implies "never was approved") — not yet wired to any action, held for
// parity with Deliverer's status shape.
enum BusinessApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

// Distinguishes an ordinary Business Marketplace seller from a School
// Vendor (food/drink/snack seller operating the fixed 5-8PM window, sold
// through Vendor cart/checkout/delivery slots — see
// docs/marketplace/decisions/vendor-extends-business.md for why this is a
// discriminator on Business rather than a parallel table). Defaults to
// BUSINESS so every existing row and every code path that doesn't branch
// on `type` keeps behaving exactly as before.
enum BusinessType {
  BUSINESS
  SCHOOL_VENDOR
}

model Business {
  id                    String                  @id @default(uuid())
  name                  String
  industry              String
  description           String                  @db.Text
  // SCHOOL_VENDOR-only from here down to `pausedReason` — null/false for
  // ordinary BUSINESS rows and never read by Business Marketplace code.
  type                  BusinessType            @default(BUSINESS)
  // Food | Drinks | Snacks | Other (see services/marketplace/vendor/shared/vendor-categories.ts)
  // — free text, same convention as `industry`, not a foreign key.
  vendorCategory        String?
  // Vendor operating window (spec: 5PM-8PM), "HH:MM" — distinct from a
  // deliverer's preferred availability and from the actual per-order
  // delivery slot (VendorDeliverySlot). See docs/marketplace/systems/vendor-system.md.
  availabilityStart     String?
  availabilityEnd       String?
  // Vendor's own self-service "temporarily unavailable" toggle — distinct
  // from approvalStatus=SUSPENDED and `blocked` below, which are both
  // admin-only enforcement actions. A paused vendor keeps its approval and
  // can unpause itself; a suspended/blocked one cannot.
  paused                Boolean                 @default(false)
  pausedAt              DateTime?
  pausedReason          String?                 @db.Text
  approvalStatus        BusinessApprovalStatus  @default(PENDING_APPROVAL)
  approvedAt            DateTime?
  approvedBy            String?
  rejectedAt            DateTime?
  rejectionReason       String?                 @db.Text
  // Profile image, uploaded to Cloudinary (see
  // services/external_utils/cloudinary.ts) from the onboarding form
  // (src/app/studashboard/marketplace/business/create/page.tsx). Both are
  // set together — public_id so the asset can be replaced/deleted later,
  // secure_url for actually rendering it.
  public_id             String?
  secure_url            String?
  // Free-text "how to reach this business" the onboarding form collects
  // (phone, email, whatever the owner wants shown) — separate from the
  // structured social links below.
  contactInfo           String?
  // These used to be required, but the onboarding form
  // (business/create/page.tsx) only collects name/industry/description/
  // contact for now — payment/banking/service-hours details are meant to
  // be filled in later from the business dashboard's edit view, so they're
  // nullable until a business actually sets them up for real transactions.
  paymentMethod         String?
  bankName              String?
  // Re-added for the seller-payout system (src/lib/seller-payout.ts) —
  // creating a Paystack transfer recipient needs the bank code, not just
  // the display name. Previously dropped when nothing needed it; see
  // docs/marketplace/decisions/business-bank-code-reintroduced.md.
  bankCode              String?
  accountNumber         String?
  accountHolderName     String?
  paystackRecipientCode String?
  location              String?
  serviceDays           String?
  serviceTimes          String?
  instagram             String?
  linkedin              String?
  website               String?
  userId                String
  visitors              Int                     @default(0)
  // Delivery-restriction state — see
  // docs/marketplace/decisions/seller-dropoff-deadline.md. Set true the
  // moment a seller misses the 15-hour drop-off deadline; cleared only once
  // every outstanding LateDeliveryFine for this business is confirmed paid
  // via Paystack (never just because a payment attempt was opened).
  deliveryRestricted    Boolean                 @default(false)
  deliveryRestrictedAt  DateTime?
  lateDeliveryCount     Int                     @default(0)
  // Admin verification — distinct from deliveryRestricted (which is about
  // an unpaid late-delivery fine, not trust/legitimacy). Set once by an
  // admin reviewing the business; never auto-set. See
  // docs/marketplace/systems/admin-system.md.
  verified              Boolean                 @default(false)
  verifiedAt            DateTime?
  verifiedBy            String?
  // Admin block — also distinct from deliveryRestricted. A blocked
  // business is not deleted; its historical products/orders/events remain
  // intact and queryable, only new activity is meant to be prevented (see
  // docs/marketplace/security/gaps.md for what's actually enforced today).
  blocked               Boolean                 @default(false)
  blockedAt             DateTime?
  blockedReason         String?                 @db.Text
  blockedBy             String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders                Order[]
  products              Product[]
  deliveryDays          BusinessDeliveryDay[]
  lateDeliveryFines     LateDeliveryFine[]
  deliveryItems         DeliveryItem[]
  deliveryHandoffs      Delivery_x_businesses[]
  reports               BusinessReport[]
  verificationRequests  BusinessVerificationRequest[]
  // Universal, vendor-level add-ons (see Side model) — SCHOOL_VENDOR only.
  sides                 Side[]
  // Own configured per-timeframe order-fulfillment capacity — see
  // VendorTimeframeCapacity's own comment. SCHOOL_VENDOR only.
  timeframeCapacities   VendorTimeframeCapacity[]

  @@index([userId])
  @@index([industry])
  @@index([createdAt])
  @@index([visitors])
  @@index([deliveryRestricted])
  @@index([verified])
  @@index([blocked])
  @@index([approvalStatus])
  @@index([type])
}

// A universal, vendor-level add-on (e.g. "Fries", "Extra sauce") — never
// tied to one Product, per the spec's "sides are not per-product" rule.
// A buyer can order Sides alone or alongside Product/ProductVariant lines
// in the same Vendor cart/order (see CartItem.sideId, OrderItem.sideId).
// SCHOOL_VENDOR-only; a plain Business never has Side rows.
model Side {
  id         String      @id @default(uuid())
  businessId String
  name       String
  price      Float
  available  Boolean     @default(true)
  // Null = not inventory-tracked (unlimited/always available while
  // `available` is true) — matches how Product.stock is always a concrete
  // Int, but Sides may legitimately not need quantity tracking at all.
  stock      Int?
  // Same data-driven service-fee exemption as Product.serviceFeeExempt —
  // sides are already exempt from the service fee by rule (spec §19), this
  // field is reserved for future asymmetric side fee rules and defaults
  // to true so a Side never accidentally counts as a chargeable item.
  serviceFeeExempt Boolean @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([businessId])
  @@index([available])
}

// A business's self-service request to be verified (the "Get Verified"
// button — services/marketplace/business/request-verification.ts),
// distinct from Business.verified/verifiedAt/verifiedBy above, which is
// the resulting badge state once a request is approved. Only one row per
// business is ever meaningfully "current" — request-verification.ts
// blocks creating a new one while a PENDING row already exists — but old
// REJECTED/APPROVED rows are kept for history rather than overwritten.
enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model BusinessVerificationRequest {
  id              String                    @id @default(uuid())
  businessId      String
  status          VerificationRequestStatus @default(PENDING)
  createdAt       DateTime                  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?                   @db.Text
  business        Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

enum ReportStatus {
  PENDING
  REVIEWED
}

// A buyer's report against a business — created from
// services/marketplace/business/report-business.ts (a small "Report
// business" action on the product detail modal, since no dedicated public
// business-profile page exists yet). Reviewed by an admin via
// services/marketplace/admin/review-report.ts. See
// docs/marketplace/systems/admin-system.md.
model BusinessReport {
  id         String       @id @default(uuid())
  businessId String
  reporterId String
  reason     String       @db.Text
  status     ReportStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime     @default(now())
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

// Append-only audit log for admin actions that aren't scoped to one Order
// (which already has its own OrderEvent history) — promoting a user,
// verifying/blocking a business, reviewing a report. See
// docs/marketplace/systems/admin-system.md.
model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  message    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Singleton row (always id = "default", upserted into existence on first
// read/write — see services/marketplace/admin/shared/marketplace-settings.ts)
// holding the two admin-configurable operational time windows: when sellers
// should physically drop off at the central drop-off point, and when the
// coordinator hands assigned batches to deliverers. Times are stored as
// "HH:MM" (24-hour, local time) strings rather than DateTime — these are
// daily recurring wall-clock windows, not calendar timestamps, so a
// DateTime column would force an arbitrary/meaningless date part onto them.
model MarketplaceSettings {
  id                 String   @id @default("default")
  dropoffWindowStart String   @default("17:00")
  dropoffWindowEnd   String   @default("19:00")
  handoffWindowStart String   @default("15:00")
  handoffWindowEnd   String   @default("16:00")
  // Where the central drop-off point physically is (address/room string),
  // shown to sellers and the coordinator alongside the drop-off window.
  // Optional — null until an admin sets it via the Settings tab.
  dropoffLocation    String?
  // Descriptive detail for the same central drop-off point, added for the
  // School Vendor flow (spec: location name/instructions/active-flag) —
  // `dropoffLocation` above remains the address/room string every existing
  // consumer already reads; these are purely additive.
  dropoffLocationName         String?
  dropoffLocationInstructions String? @db.Text
  dropoffLocationActive       Boolean @default(true)
  // School Vendor checkout fees — admin-configurable, snapshotted onto
  // VendorDeliveryBooking/Order at booking time (see
  // services/marketplace/vendor-checkout/calculate-vendor-checkout-summary.ts)
  // so a later change here never alters historical orders. Defaults match
  // the spec (₦1000 flat delivery fee per checkout, ₦100 per distinct
  // chargeable main item).
  vendorDeliveryFee      Float @default(1000)
  vendorServiceFeeAmount Float @default(100)
  // Flat rate paid to a deliverer per (deliverer, vendor) handoff —
  // snapshotted onto Delivery_x_businesses.delivererPayoutAmount at
  // pickup-confirmation time (confirm-pickup.ts), never re-read live
  // later, so changing this never alters an already-confirmed handoff's
  // payout amount.
  delivererPayoutAmount  Float @default(500)
  updatedAt          DateTime @updatedAt
  updatedBy          String?
}

model Product {
  id            String           @id @default(uuid())
  name          String
  // Free-text category, same convention as Business.industry (reuses the
  // same services/marketplace/shared/categories.ts list in the create
  // product form) rather than a foreign key to the separate Category model.
  category      String
  description   String           @db.Text
  price         Float
  // Optional in the create-product form — defaults to 0 (profit will equal
  // revenue for a product until its real cost is filled in).
  cost          Float            @default(0)
  image         String?
  public_id     String?
  secure_url    String?
  stock         Int              @default(0)
  rating        Float            @default(0)
  ratingCount   Int              @default(0)
  // School Vendor checkout only — whether this product is excluded from
  // the flat per-item service fee (spec example: fries). Data-driven, not
  // a hardcoded product-name check — see
  // services/marketplace/vendor-checkout/calculate-vendor-checkout-summary.ts.
  // Meaningless (always false, unread) for a Business product.
  serviceFeeExempt Boolean       @default(false)
  businessId    String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants      ProductVariant[]
  variantFields VariantField[]
  // Additional gallery images beyond the single image/public_id/secure_url
  // fields above, which stay as the "primary" image for backward
  // compatibility with every existing single-image consumer (product
  // cards, etc). See services/marketplace/product/shared/product-images.ts.
  images        ProductImage[]

  @@index([businessId])
  @@index([createdAt])
  @@index([rating])
}

// One product's gallery image, ordered by position (0 = primary — mirrored
// onto Product.image/public_id/secure_url so nothing that only reads those
// three fields needs to change). Sellers can have zero of these (a product
// created before this model existed, or one that's never had more than one
// image) — in that case the product's single legacy image fields are the
// only image, and no ProductImage row exists at all.
model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  secureUrl  String
  publicId   String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model VariantField {
  id        String         @id @default(uuid())
  name      String
  productId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    VariantValue[]

  @@unique([productId, name])
}

model VariantValue {
  id            String                         @id @default(uuid())
  value         String
  fieldId       String
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  field         VariantField                   @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  variantValues VariantValueOnProductVariant[]

  @@unique([fieldId, value])
}

model ProductVariant {
  id            String                         @id @default(uuid())
  productId     String
  price         Float
  isCustomPrice Boolean                        @default(false)
  stock         Int                            @default(0)
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  product       Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantValues VariantValueOnProductVariant[]

  @@index([productId])
}

model VariantValueOnProductVariant {
  id        String         @id @default(uuid())
  variantId String
  valueId   String
  value     VariantValue   @relation(fields: [valueId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, valueId])
  @@index([valueId])
}

model Order {
  id                         String               @id @default(uuid())
  // The seller's accept/reject decision for their side of the checkout.
  // Starts PENDING_SELLER; see OrderStatus's own comment for why that's the
  // literal value (not just a display label) and how it differs from
  // deliveryOutcome below.
  status                     OrderStatus          @default(PENDING_SELLER)
  rejectionReason            String?              @db.Text
  // Set only by the 5-hourly seller-response cron
  // (src/app/api/cron/seller-response/route.ts) when it auto-rejects an
  // order the seller never responded to — distinguishes "seller explicitly
  // rejected" from "seller went silent" without needing a second status.
  autoRejected               Boolean              @default(false)
  acceptedAt                 DateTime?
  rejectedAt                 DateTime?
  cancelledAt                DateTime?
  cancellationReason         String?              @db.Text
  // Only meaningful once status = ACCEPTED. See FulfillmentStatus's comment.
  fulfillmentStatus          FulfillmentStatus?
  sellerMarkedReadyAt        DateTime?
  pickupScheduledAt          DateTime?
  // Seller -> Delivery Coordinator physical handoff, OTP-verified (see
  // docs/marketplace/security/otp-security.md). The seller requests the
  // handoff (initiate-order-dropoff.ts), which issues dropoffOtp; the
  // coordinator enters it (confirm-seller-dropoff.ts). sellerDroppedOffAt
  // and coordinatorReceivedAt are only ever set together, at the moment the
  // OTP verifies — there is deliberately no "self-attested" drop-off path.
  dropoffOtp                 String?
  dropoffOtpExpiry           DateTime?
  dropoffOtpAttempts         Int                  @default(0)
  sellerDroppedOffAt         DateTime?
  coordinatorReceivedAt      DateTime?
  // The admin (delivery coordinator) User.id who verified the seller's
  // drop-off OTP — distinct from delivererConfirmedPickupAt below, which is
  // the *next* handoff (coordinator -> deliverer).
  coordinatorReceivedBy      String?
  delivererConfirmedPickupAt DateTime?
  // Rollup of this order's items' DeliveryStatus — see
  // OrderDeliveryOutcome's own comment.
  deliveryOutcome            OrderDeliveryOutcome @default(PENDING)
  // The reusable estimated-delivery calculation
  // (src/lib/estimated-delivery.ts) writes both of these at checkout time,
  // from the business's configured delivery days — "estimated," never
  // "expected," per docs/marketplace/data/delivery-days.md.
  estimatedDeliveryAt        DateTime?
  deliveryWindowStart        DateTime?
  deliveryWindowEnd          DateTime?
  totalAmount                Float
  userId                     String
  businessId                 String
  isDisputed                 Boolean              @default(false)
  disputeReason              String?              @db.Text
  disputeCreatedAt           DateTime?
  disputeResolvedAt          DateTime?
  disputeResolvedBy          String?
  disputeResolution          String?              @db.Text
  // Snapshotted from the buyer's location at checkout (src/lib/order-fulfillment.ts),
  // not a live reference to User.location — an order should keep showing
  // where it was actually meant to go even if the buyer edits their
  // profile location later.
  deliveryLocation           String?
  // Not @unique: a checkout can span multiple businesses' products at
  // once (see src/lib/order-fulfillment.ts), which creates one Order per
  // business but pays for all of them in a single Paystack transaction —
  // so several Order rows legitimately share one reference.
  paystackReference          String?
  // Whether the buyer's payment was actually collected by Paystack — kept
  // deliberately separate from `status`/escrow: this is "did the buyer pay
  // at all," not "what's happening to that money since." See
  // OrderItem.escrowStatus for the latter, tracked per item.
  paymentStatus              String               @default("pending")
  // Null for Business orders. For a School Vendor order, links back to the
  // one VendorDeliveryBooking that covers this checkout's delivery slot and
  // (shared, charged-once) delivery fee — see VendorDeliveryBooking's own
  // comment for why the delivery fee lives there instead of here.
  vendorDeliveryBookingId    String?
  // Set the moment this (vendor-only) order first enters
  // DELIVERED_PENDING_DISPUTE_WINDOW — the 24h dispute-window cron
  // (services/marketplace/vendor-delivery/dispute-window-sweep.ts)
  // compares against THIS timestamp, not `updatedAt` (which changes on
  // any field edit, not just this transition).
  deliveredPendingDisputeAt DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  business                   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorDeliveryBooking      VendorDeliveryBooking? @relation(fields: [vendorDeliveryBookingId], references: [id])
  items                      OrderItem[]
  events                     OrderEvent[]

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@index([createdAt])
  @@index([businessId, status, createdAt])
  @@index([paystackReference])
  @@index([status, createdAt])
  @@index([fulfillmentStatus, sellerDroppedOffAt])
  @@index([vendorDeliveryBookingId])
}

// One row per checkout that contains School Vendor items — keyed by the
// same shared paystackReference the resulting per-vendor Order rows carry
// (mirrors the existing "one Order per business, shared reference"
// convention — see docs/marketplace/decisions/one-order-per-business-shared-reference.md).
// This exists specifically to hold the ONE flat delivery fee for a
// checkout that may span multiple vendors, so it's charged once, not once
// per resulting Order — see docs/marketplace/decisions/vendor-extends-business.md.
// Also the unit deliverer capacity is booked against: a slot's
// `delivererCapacity` limits concurrent CONFIRMED+PENDING_PAYMENT bookings
// for the same (slotId, bookedFor) pair, not concurrent Orders.
model VendorDeliveryBooking {
  id                String              @id @default(uuid())
  userId             String
  slotId             String
  // Not @unique — same rationale as Order.paystackReference: normally one
  // booking per reference, but kept non-unique for consistency with how
  // the rest of checkout already treats this as a grouping key, not an
  // identity constraint.
  paystackReference   String
  // Snapshot of MarketplaceSettings' (or an equivalent vendor settings
  // value's) configured delivery fee at booking time — never re-read live,
  // so an admin changing the fee later never alters historical bookings.
  deliveryFee         Float
  // Snapshot of the total flat service fee for this checkout (chargeable
  // item count x MarketplaceSettings.vendorServiceFeeAmount at booking
  // time). Lives here, not on any one vendor Order, for the same reason as
  // deliveryFee — it's a platform fee, not money owed to a vendor, and a
  // checkout can span multiple vendor Orders.
  serviceFee          Float  @default(0)
  status              VendorBookingStatus @default(PENDING_PAYMENT)
  // Calendar date this slot booking applies to (the slot itself only
  // defines a recurring daily wall-clock window).
  bookedFor           DateTime
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id])
  slot                VendorDeliverySlot  @relation(fields: [slotId], references: [id])
  orders              Order[]

  @@index([slotId, bookedFor])
  @@index([paystackReference])
  @@index([status])
  @@index([userId])
}

enum VendorBookingStatus {
  // Created inside the booking transaction before payment is confirmed —
  // counts toward slot capacity so two concurrent checkouts can't both
  // reserve the last slot, but is never itself proof of a paid order (see
  // docs/marketplace/systems/vendor-delivery-system.md: cart/checkout is
  // never a reservation on its own — this row only exists once the booking
  // transaction has run, which only happens after slot/stock are
  // revalidated inside that same transaction).
  PENDING_PAYMENT
  // Set by confirmPaymentByReference once Paystack confirms payment, in
  // the same transaction that flips the linked Order(s)' paymentStatus.
  CONFIRMED
  CANCELLED
}

// Admin-configurable delivery window (spec: 5-6PM/6-7PM/7-8PM) — a real
// row, not a hardcoded array, so admins can add/edit/retire slots and
// reconfigure capacity without a code change. Seeded with the three
// default windows (see prisma/seed-vendor-delivery-slots.ts); nothing in
// application code should ever hardcode "3 slots" or MAX_DELIVERERS.
model VendorDeliverySlot {
  id                     String                  @id @default(uuid())
  // Admin-editable display string, e.g. "5:00 PM - 6:00 PM".
  label                  String
  // "HH:MM", 24-hour, local time — same convention as MarketplaceSettings'
  // window fields.
  windowStart            String
  windowEnd              String
  // A customer cannot book this slot once fewer than this many minutes
  // remain before windowStart. Default matches the spec's 1h30 cutoff.
  // Enforced by services/marketplace/vendor-delivery/is-slot-bookable.ts,
  // the one centralized function both frontend display and backend
  // booking must call — never re-implemented ad hoc.
  bookingCutoffMins      Int                     @default(90)
  // How many minutes before windowStart the vendor must have the order
  // ready for the deliverer to collect at the vendor's own location —
  // there is no central drop-off point for vendors (see
  // docs/marketplace/decisions/vendor-independent-architecture.md).
  vendorPrepDeadlineMins Int                     @default(30)
  // Admin-configured number of DELIVERER positions/roster slots for this
  // timeframe — feeds the deliverer roster/assignment system
  // (DelivererRosterAssignment) ONLY. This is deliberately NOT the same
  // thing as a vendor's own order-fulfillment capacity for this timeframe
  // (see VendorTimeframeCapacity) — the two are independent systems and
  // this field must never be read anywhere in the customer booking/
  // checkout path. See the decision doc above for why they were
  // originally (incorrectly) conflated.
  delivererCapacity      Int                     @default(1)
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  bookings               VendorDeliveryBooking[]
  vendorCapacities       VendorTimeframeCapacity[]
  rosterAssignments      DelivererRosterAssignment[]

  @@index([active])
}

// A vendor's OWN configured ceiling on how many customer orders it can
// fulfill during one VendorDeliverySlot — spec: "Set Product Deliveries
// Per Time Range." Vendor-configured (via the vendor's own dashboard,
// never the Business dashboard), vendor-owned, and completely independent
// of VendorDeliverySlot.delivererCapacity (admin's deliverer-roster
// capacity) — see that field's own comment. Enforced only at booking time
// inside create-vendor-orders-for-checkout.ts's Serializable transaction,
// by counting existing Orders for (businessId, slotId, date) against this
// row's `capacity` — never a mutable decrementing counter, so restoring
// capacity after a cancellation/refund is automatic (the count just goes
// back down) rather than needing its own reconciliation logic.
model VendorTimeframeCapacity {
  id         String             @id @default(uuid())
  businessId String
  slotId     String
  capacity   Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slot       VendorDeliverySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([businessId, slotId])
  @@index([businessId])
  @@index([slotId])
}

// Admin-managed "who is on duty for this timeframe on this date" —
// independent of any specific order (spec §15-19). This is what the Admin
// Vendor Delivery roster lists/edits and what a deliverer's own dashboard
// reads to show their upcoming schedule. Distinct from Delivery_x_businesses
// (the actual per-vendor pickup handoff for specific ready orders, created
// only once there's something to collect) — a deliverer can be rostered
// for a timeframe before any orders exist yet.
enum RosterAssignmentStatus {
  ASSIGNED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model DelivererRosterAssignment {
  id          String                 @id @default(uuid())
  delivererId String
  slotId      String
  // Calendar date this roster assignment applies to — same convention as
  // VendorDeliveryBooking.bookedFor (a date, not a timestamp).
  date        DateTime
  status      RosterAssignmentStatus @default(ASSIGNED)
  assignedBy  String
  assignedAt  DateTime               @default(now())
  // Set once the deliverer is confirmed present — see spec §19's 30-minute
  // early-arrival requirement; this is what lets admin distinguish "on
  // time" from "late" from "no-show" (status) after the fact.
  arrivedAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deliverer   Deliverer              @relation(fields: [delivererId], references: [id], onDelete: Cascade)
  slot        VendorDeliverySlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([delivererId])
  @@index([slotId, date])
  @@index([date])
}

model OrderItem {
  id                     String              @id @default(uuid())
  quantity               Int
  // The historical snapshot — see docs/marketplace/data/price-snapshots.md.
  // Never re-read from Product.price after creation; escrow/payout
  // calculations must always use this field, never the live product price.
  price                  Float
  orderId                String
  // Exactly one of productId/sideId is set — see CartItem's comment for the
  // same product-vs-side duality, snapshotted forward from the cart line.
  productId              String?
  sideId                 String?
  selectedVariants       String?             @db.Text
  // The specific ProductVariant bought, if the product had any (see
  // services/marketplace/product/shared/product-variants.ts). variantName
  // is a snapshot (same rationale as `price` above) — a variant can be
  // edited/renamed/deleted after this order is placed, but the order must
  // keep showing what was actually bought at purchase time.
  variantId              String?
  variantName            String?
  // Item-level rejection: distinct from Order.status/rejectionReason so a
  // seller can reject specific items within a multi-item order (e.g. one
  // is out of stock) without rejecting the whole order. When the seller
  // rejects the *whole* order, every item is marked rejected the same way.
  rejectedAt             DateTime?
  rejectionReason        String?             @db.Text
  cancelledAt            DateTime?
  cancellationReason     String?             @db.Text
  // Delivery-side tracking. Null until a DeliveryItem is created for this
  // OrderItem (see DeliveryItem) — kept denormalized here too (rather than
  // always joining through DeliveryItem) so order/item status can be
  // queried without a join, same convention as Order.status itself.
  deliveryStatus         DeliveryStatus?
  deliveryAttempted      DeliveryAttempted   @default(PENDING)
  failedDeliveryAttempts Int                 @default(0)
  retryDeliveryAt        DateTime?
  deliveryConfirmedAt    DateTime?
  // Buyer delivery OTP — see docs/marketplace/security/otp-security.md.
  // Per item (not per order) because the deliverer confirms delivery one
  // selected item at a time.
  deliveryOtp            String?
  deliveryOtpExpiry      DateTime?
  deliveryOtpAttempts    Int                 @default(0)
  // Escrow/payout — see EscrowPaymentStatus's and PayoutStatus's own
  // comments for why these are two separate fields.
  escrowStatus           EscrowPaymentStatus @default(HELD)
  refundedAt             DateTime?
  refundReference        String?
  // Item-level refund detail (spec §31-32) — refundedAt/refundReference
  // above already cover timestamp + provider reference; these fill the
  // remaining "reason/who/why it failed" gaps. refundInitiatedBy is a
  // free-text actor label (admin user id, or "system" for an automated
  // trigger), matching AdminActionLog's own free-text `action` convention
  // rather than a foreign key, since not every initiator is an admin.
  refundReason           String?             @db.Text
  refundInitiatedBy      String?
  refundFailureReason    String?             @db.Text
  payoutStatus           PayoutStatus?
  payoutAttempts         Int                 @default(0)
  payoutProcessingAt     DateTime?
  payoutSucceededAt      DateTime?
  payoutFailedAt         DateTime?
  payoutFailureReason    String?             @db.Text
  payoutReference        String?
  order                  Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  side                   Side?               @relation(fields: [sideId], references: [id], onDelete: Cascade)
  variant                ProductVariant?     @relation(fields: [variantId], references: [id])
  deliveryItem           DeliveryItem?
  events                 OrderEvent[]

  @@index([orderId])
  @@index([deliveryStatus])
  @@index([escrowStatus])
  @@index([payoutStatus])
  @@index([retryDeliveryAt])
  @@index([productId])
  @@index([sideId])
  @@index([variantId])
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String?  @db.Text
  businessId String
  createdAt  DateTime @default(now())
}

// Which "area" a notification belongs to — MARKETPLACE notifications are
// shown in the marketplace navbar's bell (NotificationDropdown.tsx),
// ADMIN ones in the admin dashboard's bell. Both are the same underlying
// model/writer (services/marketplace/notifications/notification.service.ts)
// — this is purely a filter, not a separate table, per the "one
// notification writer" rule.
enum NotificationScope {
  MARKETPLACE
  ADMIN
}

model Notification {
  id         String            @id @default(uuid())
  userId     String
  scope      NotificationScope @default(MARKETPLACE)
  type       String
  title      String
  message    String
  read       Boolean           @default(false)
  businessId String?
  orderId    String?
  link       String?
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Skill {
  id                     String              @id @default(uuid())
  name                   String
  description            String              @db.Text
  displayName            String
  yearsOfExperience      Int
  expertiseLevel         String
  paymentMethod          String
  profilePicture         String?
  profilePicturePublicId String?
  startingPrice          Float
  serviceDays            String
  serviceTimes           String
  mostActiveSocial       String?
  instagram              String?
  linkedin               String?
  twitter                String?
  website                String?
  achievements           String?             @db.Text
  visitors               Int                 @default(0)
  userId                 String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications          SkillNotification[]
  offers                 SkillOffer[]
  reviews                SkillReview[]

  @@index([userId])
  @@index([visitors])
  @@index([createdAt])
}

model SkillOffer {
  id                      String              @id @default(uuid())
  status                  String              @default("pending")
  offerFrom               DateTime
  offerTo                 DateTime
  description             String?             @db.Text
  originalPrice           Float
  currentPrice            Float?
  skillOwnerAcceptedPrice Float?
  buyerAcceptedPrice      Float?
  skillId                 String
  buyerId                 String
  fulfillmentOtp          String?
  fulfillmentOtpExpiry    DateTime?
  fulfillmentOtpAttempts  Int                 @default(0)
  completedAt             DateTime?
  cancelledAt             DateTime?
  cancelledBy             String?
  cancellationReason      String?             @db.Text
  rejectedAt              DateTime?
  rejectedBy              String?
  disputedAt              DateTime?
  disputedBy              String?
  disputeReason           String?             @db.Text
  ignoredAt               DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  counterOffers           SkillCounterOffer[]
  buyer                   User                @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  skill                   Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model SkillCounterOffer {
  id           String     @id @default(uuid())
  offerId      String
  counterPrice Float
  madeBy       String     @default("buyer")
  reason       String     @db.Text
  createdAt    DateTime   @default(now())
  offer        SkillOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

model SkillReview {
  id        String   @id @default(uuid())
  skillId   String
  buyerId   String
  rating    Int
  comment   String?  @db.Text
  sentiment String
  createdAt DateTime @default(now())
  buyer     User     @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([skillId])
}

model SkillNotification {
  id        String   @id @default(uuid())
  skillId   String
  message   String   @db.Text
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model CartItem {
  id               String          @id @default(uuid())
  quantity         Int             @default(1)
  userId           String
  // Exactly one of productId/sideId must be set — a cart line is either a
  // Product(+variant) purchase or a universal Side purchase, never both.
  // Enforced at the service layer (see services/marketplace/vendor-cart/),
  // not the DB, since Prisma/Postgres here has no CHECK-constraint support
  // in this schema's conventions. productId was required before Sides
  // existed; it's now optional purely to allow side-only cart lines.
  productId        String?
  sideId           String?
  selectedVariants String?         @db.Text
  variantId        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  side             Side?           @relation(fields: [sideId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([sideId])
  @@index([variantId])
}

model SkillType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Schedule {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#3498db")
  focus     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([userId])
  @@index([createdAt])
}

model Task {
  id         String    @id @default(uuid())
  userId     String
  scheduleId String?
  title      String
  category   String
  details    String?   @db.Text
  date       String
  startTime  String
  duration   Int
  color      String    @default("#3498db")
  completed  Boolean   @default(false)
  ignored    Boolean   @default(false)
  ignoredAt  DateTime?
  focus      Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduleId])
  @@index([date])
  @@index([completed])
  @@index([ignored])
  @@index([createdAt])
}

model student_playlists {
  id              Int     @id @default(autoincrement())
  student_id      String  @db.VarChar(255)
  context         String  @db.Text
  recommendations String  @db.Text
  trigger_event   String? @db.VarChar(255)

  @@index([id])
}
