// Existing marketplace-schema tables shared with the standalone app.
// Compose with the authoritative public models through scripts/generate-core-prisma.mjs.
model AccountState {
  userId         String    @id
  // Account block (Marketplace admin action). Checked on EVERY authenticated request (src/lib/session.ts), so an
  // already-issued Marketplace session stops working immediately — not just at the next login.
  blocked        Boolean   @default(false)
  blockedAt      DateTime?
  blockedReason  String?   @db.Text
  blockedBy      String?
  // Bumped to invalidate every existing Marketplace session for this user (block, admin revoke).
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([blocked])
  @@schema("marketplace")
}

// Attempt counter for abuse-sensitive actions (sign-in), keyed by action + subject (an email or an IP).
// Database-backed so the limit holds across serverless instances. See src/lib/throttle.ts.
model AuthThrottle {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
  @@schema("marketplace")
}

// One row identifying this database to the Marketplace: which app set it up and for which environment
// (local / test / staging / production). Written by scripts/db-guard.mjs after migrating; the runtime role can only
// read it. Startup refuses to run when `environment` differs from MARKETPLACE_ENV — so a staging deployment can't
// quietly write to the production database. It is one of several checks (src/lib/db-target.ts), not the only one.
model MarketplaceInstance {
  id          String   @id @default("singleton")
  app         String
  environment String
  createdAt   DateTime @default(now())

  @@schema("marketplace")
}

// ---------------------------------------------------------------------------------------------------------------------
// Recurring delivery rosters (services/marketplace/delivery-roster/). Marketplace-owned because AkadVerse's tables can't
// be changed from here. A slotId is a public."VendorDeliverySlot".id (VENDOR) or a CentralDeliverySlot.id
// (MARKETPLACE); delivererId / orderId / bookingId are public ids. None of them is a foreign key (the roles hold no
// REFERENCES on those tables), so every write validates them in the service layer.
// ---------------------------------------------------------------------------------------------------------------------

// The two delivery operations a roster can belong to. MARKETPLACE = Business orders, collected at the central drop-off
// point; VENDOR = School Vendor orders, collected from each vendor (VendorDeliverySlot timeframes).
enum DeliveryOperation {
  MARKETPLACE
  VENDOR

  @@schema("marketplace")
}

// How a ScheduledDelivery got its planned deliverer: resolved from the roster (may be re-planned when the roster
// changes, but only after an admin chooses to), or set by an admin (never changed automatically).
enum DeliveryPlanSource {
  ROSTER
  MANUAL

  @@schema("marketplace")
}

// One row per operation: the default maximum deliveries per slot occurrence. Null = no limit (how both operations
// behaved before rosters existed).
model DeliveryRosterSettings {
  operation            DeliveryOperation @id
  defaultMaxDeliveries Int?
  // Where deliverers report to be checked in before a shift. One place per operation for now — all deliverers are
  // male; separate meeting points will be needed once female deliverers join (see vendor-delivery/handover/shift.ts).
  checkInLocation      String?
  updatedAt            DateTime          @updatedAt
  updatedBy            String?

  @@schema("marketplace")
}

// Time slots for the central Marketplace delivery operation (the Vendor operation uses public."VendorDeliverySlot").
// Business purchases require a priced active slot; product estimates retain a weekday fallback.
model CentralDeliverySlot {
  prices BusinessDeliveryPrice[]
  id             String   @id @default(uuid())
  label          String
  // "HH:MM", 24-hour, school timezone — same convention as VendorDeliverySlot.
  windowStart    String
  windowEnd      String
  // Deliverer positions (staffing), the equivalent of VendorDeliverySlot.delivererCapacity. Not a delivery limit.
  staffPositions Int      @default(1)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
  @@schema("marketplace")
}

// The recurring template's per-cell delivery limit: max deliveries for every occurrence of (slot, weekday).
// Null = use DeliveryRosterSettings.defaultMaxDeliveries. weekday is ISO: 1 = Monday ... 7 = Sunday.
model RosterSlotDay {
  id            String            @id @default(uuid())
  operation     DeliveryOperation
  slotId        String
  weekday       Int
  maxDeliveries Int?
  updatedAt     DateTime          @updatedAt
  updatedBy     String?

  @@unique([operation, slotId, weekday])
  @@schema("marketplace")
}

// The recurring template's staffing: this deliverer works this slot on this weekday, every week, until removed.
// A template only — it is never itself an order assignment (see ScheduledDelivery).
model RosterAssignment {
  id          String            @id @default(uuid())
  operation   DeliveryOperation
  slotId      String
  weekday     Int
  delivererId String
  createdBy   String
  createdAt   DateTime          @default(now())

  @@unique([operation, slotId, weekday, delivererId])
  @@index([delivererId])
  @@schema("marketplace")
}

// A date-specific override of the template for one slot occurrence. Never changes the template.
//   closed            -> no deliveries may be booked into that occurrence;
//   maxDeliveries     -> that occurrence's limit (null = the template's);
//   replaceDeliverers -> the occurrence is staffed by exactly delivererIds (possibly nobody) instead of the template.
model RosterException {
  id                String            @id @default(uuid())
  operation         DeliveryOperation
  slotId            String
  date              DateTime          @db.Date
  closed            Boolean           @default(false)
  maxDeliveries     Int?
  replaceDeliverers Boolean           @default(false)
  delivererIds      String[]
  note              String?
  createdBy         String
  updatedBy         String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([operation, slotId, date])
  @@index([operation, date])
  @@schema("marketplace")
}

// One delivery's own slot occurrence and planned deliverer, kept apart from the template. MARKETPLACE: one row per
// Business Order (orderId) — the order's slot lives only here. VENDOR: one row per VendorDeliveryBooking (bookingId),
// whose slotId/bookedFor are authoritative and never change; slotId/date here are copied for lookups.
// The ACTUAL assignment is still the existing Delivery/DeliveryItem (assign-delivery.ts); this is the plan it starts
// from. Rows are never deleted: whether a delivery still takes up capacity is derived from its order's live state.
model ScheduledDelivery {
  isOverflow         Boolean            @default(false)
  id                 String             @id @default(uuid())
  operation          DeliveryOperation
  orderId            String?            @unique
  bookingId          String?            @unique
  slotId             String
  date               DateTime           @db.Date
  plannedDelivererId String?
  planSource         DeliveryPlanSource @default(ROSTER)
  plannedBy          String?
  plannedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([operation, slotId, date])
  @@index([plannedDelivererId])
  @@schema("marketplace")
}

// Outcome of one delivery-code submission (see DeliveryCodeSubmission).
enum DeliverySubmissionOutcome {
  VERIFIED
  REJECTED
  LATE_REVIEW

  @@schema("marketplace")
}

// The student's handover code for one Vendor delivery booking. Never stored in plaintext: codeHash verifies it,
// codeCipher lets the student see it again, maskedCode ("1_3_5_") is all a deliverer or admin ever sees.
// See src/lib/delivery-code.ts and services/marketplace/vendor-delivery/handover/.
model DeliveryHandoverCode {
  id             String    @id @default(uuid())
  bookingId      String    @unique
  codeHash       String
  codeCipher     String
  maskedCode     String
  failedAttempts Int       @default(0)
  issuedAt       DateTime  @default(now())
  issuedBy       String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@schema("marketplace")
}

enum DeliveryConfirmationMethod {
  DELIVERER
  ADMIN_FALLBACK

  @@schema("marketplace")
}

// Every delivery-code submission, online or synced from a deliverer's offline queue, or entered by an admin on the
// deliverer's behalf (method ADMIN_FALLBACK: enteredBy = the admin, fallbackReason required). submissionId is the
// client's idempotency key. receivedAt (server time) decides the end-of-day deadline (late = received at or after it);
// clientRecordedAt is audit-only. delivererId is whose items the code completes. The submitted code is never stored —
// only whether it matched. LATE_REVIEW is legacy (a late code used to wait for an admin; it now completes, late = true).
model DeliveryCodeSubmission {
  id               String                     @id @default(uuid())
  submissionId     String                     @unique
  bookingId        String
  delivererId      String
  outcome          DeliverySubmissionOutcome
  reason           String?
  codeMatched      Boolean
  deadlineAt       DateTime
  clientRecordedAt DateTime?
  receivedAt       DateTime                   @default(now())
  method           DeliveryConfirmationMethod @default(DELIVERER)
  enteredBy        String?
  fallbackReason   String?
  late             Boolean                    @default(false)
  reviewedAt       DateTime?
  reviewedBy       String?
  reviewDecision   String?
  reviewNote       String?

  @@index([bookingId])
  @@index([outcome, reviewedAt])
  @@schema("marketplace")
}

// One row per pre-slot briefing sent (slot occurrence x recipient) — the idempotency record for slot-briefing.ts.
model SlotBriefingNotice {
  id           String            @id @default(uuid())
  operation    DeliveryOperation
  slotId       String
  date         DateTime          @db.Date
  recipientKey String
  sentAt       DateTime          @default(now())

  @@unique([operation, slotId, date, recipientKey])
  @@schema("marketplace")
}

// LEGACY — unused. Created by migration 20261020120000 (a "card handed over" acknowledgement), superseded by
// DeliveryShiftCheckIn in 20261021120000 before anything wrote to it. Kept so this schema matches the database (dropping
// it would need a destructive migration); the runtime role has no access to it. Don't use.
model DeliveryCardHandover {
  id           String            @id @default(uuid())
  operation    DeliveryOperation
  slotId       String
  date         DateTime          @db.Date
  delivererId  String
  handedOverAt DateTime          @default(now())
  handedOverBy String

  @@unique([operation, slotId, date, delivererId])
  @@schema("marketplace")
}

// Attendance only: an admin (vendor manager) recorded that a deliverer reported at the meeting point for one slot
// occurrence. Never a prerequisite for processing or delivering (that needs only the assignment and the student's
// code). late = recorded after the slot had ended. See vendor-delivery/handover/shift.ts.
model DeliveryShiftCheckIn {
  id          String            @id @default(uuid())
  operation   DeliveryOperation
  slotId      String
  date        DateTime          @db.Date
  delivererId String
  checkedInAt DateTime          @default(now())
  checkedInBy String
  late        Boolean           @default(false)
  note        String?

  @@unique([operation, slotId, date, delivererId])
  @@schema("marketplace")
}

// A Vendor booking whose delivery-code deadline (end of the delivery day, school time — handover/delivery-deadline.ts)
// passed without a valid confirmation. Flagged once per (booking, deadline) by the vendor-slot-briefing job and shown
// to admins; resolved (never deleted) once the booking is delivered or cancelled, so the overdue history stays. Being
// overdue is missing confirmation, not proof of non-delivery: nothing is cancelled, refunded or paid because of it.
model DeliveryConfirmationOverdue {
  id               String    @id @default(uuid())
  bookingId        String
  deadlineAt       DateTime
  flaggedAt        DateTime  @default(now())
  adminsNotifiedAt DateTime?
  resolvedAt       DateTime?
  // "DELIVERED" (a valid code arrived after the deadline) or "CANCELLED".
  resolution       String?

  @@unique([bookingId, deadlineAt])
  @@index([resolvedAt])
  @@schema("marketplace")
}

// Marketplace-owned extensions keep shared AkadVerse order tables unchanged.
model BusinessDeliveryPrice {
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slot CentralDeliverySlot @relation(fields: [slotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  id String @id @default(uuid())
  businessId String
  slotId String
  feeKobo Int
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([businessId, slotId])
  @@index([slotId])
  @@schema("marketplace")
}
model BusinessPricingSettings {
  id String @id @default("default")
  serviceFeeKobo Int @default(15000)
  updatedAt DateTime @updatedAt
  updatedBy String?
  @@schema("marketplace")
}
model CheckoutFinancialSnapshot {
  reference String @id
  subtotalKobo Int
  deliveryFeeKobo Int
  serviceFeeKobo Int
  totalKobo Int
  currency String @default("NGN")
  orders Json
  createdAt DateTime @default(now())
  @@schema("marketplace")
}
