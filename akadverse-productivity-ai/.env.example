# Python-only provider key. Never add this value to a NEXT_PUBLIC_* variable.
GEMINI_API_KEY=
# Configurable function-calling model; verify availability for your Google project.
GEMINI_MODEL=gemini-3.5-flash-lite
AKADVERSE_API_BASE_URL=http://localhost:3000
PRODUCTIVITY_AI_SERVICE_TOKEN=
# Public verification key only. Next.js retains the private key.
PRODUCTIVITY_AI_JWT_PUBLIC_KEY=
PRODUCTIVITY_AI_JWT_KEY_ID=productivity-v1
MAX_TOOL_CALLS=10
TURN_TIMEOUT_SECONDS=55
