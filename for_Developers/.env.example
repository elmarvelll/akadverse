# =====================================================================================
# AkadVerse — LOCAL DEVELOPMENT environment template
#
#   cp for_Developers/.env.example .env
#
# Copy it to `.env` at the repository root (NOT .env.local): the Prisma CLI and the seed
# scripts only read `.env`; Next.js reads it too. `.env` is git-ignored — never commit it.
#
# Every variable is explained in for_Developers/ENVIRONMENT.md.
# Use ONLY development / test credentials here. Never paste production values into this file.
# =====================================================================================


# =====================================================================================
# DATABASE  (required)
#
# These point at the local Docker Postgres from for_Developers/docker-compose.yml
# (`npm run db:local:up`). They work as-is — no changes needed.
# The password is a throwaway for a container bound to 127.0.0.1 only.
# The app has TWO databases: Core/Marketplace and E-Learning.
# =====================================================================================

# Core + Marketplace database (prisma/schema.prisma)
DATABASE_URL="postgresql://akadverse:akadverse_local_only@localhost:5433/akadverse"
# Direct (non-pooled) connection used by Prisma migrate/db push. Locally it's the same URL.
DIRECT_URL="postgresql://akadverse:akadverse_local_only@localhost:5433/akadverse"

# E-Learning database (prisma/elearning/schema.prisma)
ELEARNING_DATABASE_URL="postgresql://akadverse:akadverse_local_only@localhost:5433/akadverse_elearning"
ELEARNING_DIRECT_URL="postgresql://akadverse:akadverse_local_only@localhost:5433/akadverse_elearning"


# =====================================================================================
# AUTHENTICATION  (NextAuth — required)
# =====================================================================================

# REQUIRED. Any long random string. Generate one with:
#   openssl rand -base64 32
#   (or) node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

NEXTAUTH_URL="http://localhost:3000"


# =====================================================================================
# GOOGLE OAUTH  (optional — only for the "Continue with Google" button)
# Email + password login works without these. Use a DEVELOPMENT OAuth client.
# =====================================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# =====================================================================================
# CLOUDINARY  (optional — business/product image uploads)
# Use your own free Cloudinary account or a dev account from the project owner.
# =====================================================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# =====================================================================================
# PAYSTACK — TEST MODE ONLY  (optional — checkout, bank list, payouts)
#
# Outside production the app ALWAYS uses PAYSTACK_TEST_SECRET_KEY (src/lib/external/paystack.ts).
# Use keys from Paystack's *Test* mode: pk_test_... / sk_test_...
# =====================================================================================

# Publishable TEST key (pk_test_...) — opens the Paystack checkout popup in the browser.
NEXT_PUBLIC_PAYSTACK_KEY=
# Secret TEST key (sk_test_...).
PAYSTACK_TEST_SECRET_KEY=

# LIVE secret key — used ONLY when NODE_ENV=production. Leave it unset locally. Never put a live key here.
# PAYSTACK_SECRET_KEY=


# =====================================================================================
# EMAIL  (Resend — optional)
#
# Leave RESEND_API_KEY empty locally: nothing is emailed, and the sign-up OTP code is
# printed in the `npm run dev` terminal instead.
# =====================================================================================

RESEND_API_KEY=
# Sender shown on Marketplace emails. Optional (a built-in default is used when empty).
MARKETPLACE_EMAIL_FROM=
# Where admin notification emails go (new businesses, verification requests...). Optional.
# Put YOUR OWN address here if you want to receive them; never someone else's.
ADMIN_EMAIL=


# =====================================================================================
# SUPABASE STORAGE  (optional — E-Learning course-material file uploads/downloads only)
#
# The databases above do NOT use Supabase locally. Only the file store does.
# Use a free DEVELOPMENT Supabase project; see ENVIRONMENT.md.
# =====================================================================================

SUPABASE_URL=
# Server-only secret. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Private bucket name; the code default is used when empty.
SUPABASE_COURSE_MATERIALS_BUCKET=


# =====================================================================================
# CRON  (optional — only to call /api/cron/* routes by hand)
# Any random string locally, e.g. `openssl rand -hex 24`.
# =====================================================================================

CRON_SECRET=


# =====================================================================================
# DEBUG  (optional)
# =====================================================================================

# Set to 1 to log every Core-database query's duration.
# DB_TIMING_DEBUG=1
