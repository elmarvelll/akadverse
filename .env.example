# Server-only Concept Explainer integration. Legacy AI_SERVICE_URL is also accepted.
CONCEPT_EXPLAINER_API_URL=
AI_SERVICE_API_KEY=
AI_SERVICE_CALLBACK_SECRET=
# HTTPS public application origin; falls back to NEXTAUTH_URL.
APP_BASE_URL=
# Enable only after schema deployment and isolated staging end-to-end verification.
AI_INGEST_ENABLED=false
# Existing shared cron authentication; configure on Vercel and external scheduler.
CRON_SECRET=
# Optional bounded retry tuning (pre-submission failures and DELETE only).
AI_INGEST_MAX_ATTEMPTS=5
AI_INGEST_RETRY_BASE_SECONDS=60
AI_INGEST_RETRY_MAX_SECONDS=3600
# AI_SERVICE_CALLBACK_ALLOWED_HOSTS belongs on the AI service, e.g. akadverse.vercel.app.
# Development-only test student login. Requires NODE_ENV=development and a local Core database.
ENABLE_DEV_LOGIN=false

# Revision-question receiver: dedicated HMAC secret shared with the AI engineer.
# Never reuse AI_SERVICE_API_KEY or AI_SERVICE_CALLBACK_SECRET.
# Apply the revision-learning migrations and explicitly enable the feature after staging verification.
AI_WEBHOOK_SECRET=
# AkadVerse-side embedding and duplicate judge credential; independent from Concept Explainer.
GEMINI_API_KEY=
# Enable only after migrations, sender secret/URL coordination and staging verification.
REVISION_QUESTIONS_ENABLED=false
REVISION_GENERATION_ENABLED=false

# Standalone Revisions: enable after the additive 20261116 workspace patch.
REVISION_WORKSPACE_ENABLED=false
# Maximum previously unreviewed questions introduced per session (0-10).
REVISION_NEW_QUESTION_LIMIT=5

# Shared by BOTH Marketplace apps for booking handover-code encryption/HMAC.
# Use the standalone's existing delivery-code key; changing it invalidates outstanding codes.
# DELIVERY_CODE_SECRET=
# Keep false while the standalone scheduler owns vendor-slot-briefing.
MARKETPLACE_VENDOR_BRIEFING_ENABLED=false
