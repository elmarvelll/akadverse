# Postgres (Supabase). DATABASE_URL is the pooled connection (pgbouncer,
# port 6543) the app uses at runtime. DIRECT_URL is the same database over
# the direct/session connection (port 5432) — required for `prisma
# migrate`/`db push`, which hang indefinitely against the transaction-mode
# pooler. Both point at the same database, just different ports/modes.
DATABASE_URL="postgresql://user:password@localhost:6543/akadverse?pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/akadverse"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Paystack
NEXT_PUBLIC_PAYSTACK_KEY=""
NEXT_PUBLIC_PAYSTACK_LIVE_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_TEST_SECRET_KEY=""

# Resend (transactional email — see src/lib/email.ts)
RESEND_API_KEY=""
MARKETPLACE_EMAIL_FROM=""

# Where admin-facing emails go — new business registrations, verification
# requests, deliverer applications. See
# services/marketplace/notifications/email.service.ts.
ADMIN_EMAIL=""

# Shared secret for /api/cron/* routes (see src/lib/cron-auth.ts + vercel.json)
CRON_SECRET=""
