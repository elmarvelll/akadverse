# Server-only Concept Explainer integration. Legacy AI_SERVICE_URL is also accepted.
CONCEPT_EXPLAINER_API_URL=
AI_SERVICE_API_KEY=
AI_SERVICE_CALLBACK_SECRET=
# HTTPS public application origin; falls back to NEXTAUTH_URL.
APP_BASE_URL=
# Enable only after schema deployment and isolated staging end-to-end verification.
AI_INGEST_ENABLED=false
# Existing shared cron authentication; configure on Vercel and external scheduler.
CRON_SECRET=
# Optional bounded retry tuning (pre-submission failures and DELETE only).
AI_INGEST_MAX_ATTEMPTS=5
AI_INGEST_RETRY_BASE_SECONDS=60
AI_INGEST_RETRY_MAX_SECONDS=3600
# AI_SERVICE_CALLBACK_ALLOWED_HOSTS belongs on the AI service, e.g. akadverse.vercel.app.
